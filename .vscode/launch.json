{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "FastAPI: 骨架 app.main (8000)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["app.main:app", "--reload", "--host", "127.0.0.1", "--port", "8000"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "FastAPI: 练习 app.fastapi_1 (8001)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["app.fastapi_1:app", "--reload", "--host", "127.0.0.1", "--port", "8001"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ]
}
